module(
    name = "bazel_sysroot_c_hello_world",
    version = "1.0",
)

bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "toolchains_llvm", version = "1.3.0")

# https://github.com/bazel-contrib/toolchains_llvm/releases/tag/v1.3.0
# please leave this path as it is.  it is correct.  Version 1.4.0 is available, but not working.
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")

# Attempting to use: https://github.com/dzbarsky/static-clang
llvm.toolchain(
    llvm_version = "20.1.1",
    libclang_rt = {
        "@bazel_sysroot_library_and_libs_amd64//:lib/linux/libclang_rt.builtins-x86_64.a": "x86_64-unknown-linux-gnu/libclang_rt.builtins.a",
    },
    sha256 = {
        "darwin-aarch64": "a4e65db49d01e4b37abcbc36a03e4f1121fbea63a7c7b58f9d49e3848a4cbdfc",
        "darwin-x86_64": "b681a621e6d456e20fdfc7626db23edad63f7dabb1442790db3397431688cb41",
        "linux-aarch64": "a71d6686edfb32e455717a1befb013b580a52042915a49f21fc25f83fff59e20",
        "linux-x86_64": "2096e63a41887a860199aec0f046f82e6469b2cd5ae4e4245a7a111bff4abe5b",
    },
    # stdlib = {
    #     #"linux-x86_64": "libc++", # clang
    #     #"linux-aarch64": "libc++",
    #     "linux-x86_64": "libstdc++", # gcc
    #     "linux-aarch64": "libstdc++",
    # },
    urls = {
        "darwin-aarch64": ["https://github.com/dzbarsky/static-clang/releases/download/v20.1.1-4/darwin_arm64.tar.zst"],
        "darwin-x86_64": ["https://github.com/dzbarsky/static-clang/releases/download/v20.1.1-4/darwin_amd64.tar.zst"],
        "linux-aarch64": ["https://github.com/dzbarsky/static-clang/releases/download/v20.1.1-4/linux_arm64.tar.zst"],
        "linux-x86_64": ["https://github.com/dzbarsky/static-clang/releases/download/v20.1.1-4/linux_amd64.tar.zst"],
