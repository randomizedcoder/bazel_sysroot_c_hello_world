# Make the toolchain repository visible
use_repo(llvm, llvm_toolchain_llvm = "llvm_toolchain")

# use_repo(llvm, "llvm_toolchain_include", "llvm_toolchain_lib")

register_toolchains("@llvm_toolchain_llvm//:all")
#register_toolchains("@llvm_toolchain_include//:all", "@llvm_toolchain_lib//:all")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "bazel_sysroot_library_and_libs_amd64",
    urls = ["https://github.com/randomizedcoder/bazel_sysroot_library_and_libs_amd64/archive/refs/heads/main.tar.gz"],
    sha256 = "f4300d4a986ecb6bbed514b108f1e26b8d658e7fbcc2d3a5751ba52f46829567",
    strip_prefix = "bazel_sysroot_library_and_libs_amd64-main/sysroot",
)
# curl -sSL https://github.com/randomizedcoder/bazel_sysroot_library_and_libs_amd64/archive/refs/heads/main.tar.gz | sha256sum

# Configure the sysroot for the LLVM toolchain
llvm.sysroot(
    # Omit 'name' to apply this sysroot configuration to the default llvm.toolchain definition above.
    # The label should point to the root of the repository that constitutes the sysroot.
    label = "@bazel_sysroot_library_and_libs_amd64//:sysroot",
    targets = ["linux-x86_64"],
)

