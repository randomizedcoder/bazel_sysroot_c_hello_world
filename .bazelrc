# .bazelrc

# Global Bazel settings
build --noenable_workspace
common --enable_bzlmod

# Platform and toolchain selection
build --platforms=@toolchains_llvm//platforms:linux-x86_64
build --extra_toolchains=@llvm_toolchain_llvm//:cc-toolchain-x86_64-linux


# Set the LLVM toolchain
build --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
build --repo_env=CC=clang
build --repo_env=CXX=clang++
build --repo_env=LD=ld.lld

# Prevent LLVM toolchain from adding its builtins library
build --repo_env=LLVM_ENABLE_RUNTIMES=compiler-rt
build --repo_env=LLVM_ENABLE_PROJECTS=clang
build --repo_env=LLVM_ENABLE_LIBCXX=OFF
build --repo_env=LLVM_ENABLE_LIBCXXABI=OFF
build --repo_env=LLVM_ENABLE_LIBUNWIND=OFF

# Set the sysroot - only use libc++ paths
build --action_env=LLVM_LIB_SEARCH_PATH=external/+_repo_rules+bazel_sysroot_library_and_libs_amd64/lib:external/+_repo_rules+bazel_sysroot_library_and_libs_amd64/lib/linux
build --action_env=LD_LIBRARY_PATH=external/+_repo_rules+bazel_sysroot_library_and_libs_amd64/lib:external/+_repo_rules+bazel_sysroot_library_and_libs_amd64/lib/linux
build --action_env=CLANG_RESOURCE_DIR=external/+_repo_rules+bazel_sysroot_library_and_libs_amd64/lib/linux

# end